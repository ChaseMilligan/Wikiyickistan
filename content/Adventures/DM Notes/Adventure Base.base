formulas:
  Untitled: ""
views:
  - type: cards
    name: View
    filters:
      and:
        - file.folder == "Adventures/DM Notes"
        - file.hasProperty("cover")
    order:
      - file.name
    image: note.cover
    imageAspectRatio: 1.6
    imageFit: ""
  - type: cards
    name: View 2
    filters:
      and:
        - file.inFolder("Adventures/DM Notes")
        - "!file.embeds.isEmpty()"
    image: file.file
    imageAspectRatio: 1.5
    cardSize: 160
